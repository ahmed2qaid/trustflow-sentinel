TRUSTFLOW_APP_ENV=development
TRUSTFLOW_DATABASE_PATH=./trustflow.db
TRUSTFLOW_UPLOAD_DIR=./uploads
TRUSTFLOW_FRONTEND_ORIGIN=http://localhost:5173

# Set to false only after adding the corresponding credentials.
TRUSTFLOW_USE_MOCK_NUTRIENT=true
TRUSTFLOW_NUTRIENT_API_KEY=
TRUSTFLOW_NUTRIENT_API_URL=https://api.nutrient.io/extraction/extract

TRUSTFLOW_USE_MOCK_SERPAPI=true
TRUSTFLOW_SERPAPI_API_KEY=
TRUSTFLOW_SERPAPI_URL=https://serpapi.com/search.json

TRUSTFLOW_USE_MOCK_LLM=true
TRUSTFLOW_OLLAMA_URL=http://localhost:11434
TRUSTFLOW_OLLAMA_MODEL=qwen3:4b
